{
  "name": "s4-sales-order-mcp",
  "version": "1.0.0",
  "description": "CAP demo: expose SAP S/4HANA API_SALES_ORDER_SRV to AI agents via the @cap-js/mcp adapter (CAP as auth broker + MCP adapter).",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/mcp": "^1.4.3",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^10.0.6"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds-dk": "^10.0.7"
  },
  "cds": {
    "mcp": {
      "per_action_tool": true
    },
    "requires": {
      "API_SALES_ORDER_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_SALES_ORDER_SRV",
        "credentials": {
          "destination": "QJ6",
          "path": "/sap/opu/odata/sap/API_SALES_ORDER_SRV"
        }
      },
      "API_PRODUCT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PRODUCT_SRV",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "QJ6",
          "path": "/sap/opu/odata/sap/API_PRODUCT_SRV"
        }
      },
      "API_PURCHASEORDER_PROCESS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PURCHASEORDER_PROCESS_SRV",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "QJ6",
          "path": "/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV",
          "queries": {
            "sap-client": "001"
          }
        }
      },
      "API_INBOUND_DELIVERY_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_INBOUND_DELIVERY_SRV",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "QJ6",
          "path": "/sap/opu/odata/sap/API_INBOUND_DELIVERY_SRV",
          "queries": {
            "sap-client": "001"
          }
        }
      },
      "auth": "xsuaa",
      "destinations": true,
      "connectivity": true,
      "[development]": {
        "auth": "mocked"
      }
    }
  }
}
